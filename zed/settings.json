// =============================================================================
// Zed User Settings (macOS)
// Base: Vim mode. Insert mode is remapped Emacs-like (see keymap.json).
// =============================================================================
{
    // =========================================================================
    // THEME
    // Tokyo Night is available as a built-in Zed theme
    // =========================================================================
    "theme": "Tokyo Night",

    // =========================================================================
    // FONT
    // Emacs: Iosevka Nerd Font, height 140, Korean fallback D2Coding
    // =========================================================================
    "buffer_font_family": "Iosevka Nerd Font",
    "buffer_font_size": 14,
    "buffer_font_weight": 400,
    "buffer_font_features": {
        "liga": true,
        "calt": true
    },
    "ui_font_family": "Iosevka Nerd Font",
    "ui_font_size": 14,
    "terminal": {
        "font_family": "Iosevka Nerd Font",
        "font_size": 14,
        "line_height": {
            "custom": 1.15
        },
        "shell": {
            "program": "zsh"
        },
        "scrollback": 10000
    },

    // =========================================================================
    // VIM MODE
    // Base keymap is Vim; Insert mode is remapped Emacs-like in keymap.json.
    // =========================================================================
    "vim_mode": true,
    "vim": {
        // Share one clipboard between Emacs (insert) C-w/M-w/C-y and Vim y/p
        "use_system_clipboard": "always",
        // Per-mode cursor: block in Normal/Visual, bar in Insert (Emacs-like)
        "cursor_shape": {
            "normal": "block",
            "visual": "block",
            "insert": "bar",
            "replace": "underline"
        }
    },

    // =========================================================================
    // CURSOR (fallback; Vim per-mode cursor above takes precedence)
    // =========================================================================
    "cursor_shape": "bar",
    "cursor_blink": false,

    // =========================================================================
    // EDITOR BEHAVIOR
    // =========================================================================
    "tab_size": 4,
    "hard_tabs": false,
    "use_autoclose": true,
    "show_completions_on_input": true,
    "show_completion_documentation": true,
    "ensure_final_newline_on_save": true,
    "format_on_save": "off",
    "auto_indent_on_paste": true,

    // =========================================================================
    // LINE NUMBERS & GUTTER
    // =========================================================================
    "line_numbers": "on",
    "gutter": {
        "line_numbers": true,
        "code_actions": true,
        "runnables": true,
        "folds": true,
        "diagnostics": true
    },

    // =========================================================================
    // SCROLLING
    // =========================================================================
    "scroll_beyond_last_line": "off",
    "vertical_scroll_margin": 3,

    // =========================================================================
    // UI — MINIMAL CHROME
    // =========================================================================
    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": false
    },
    "tab_bar": {
        "show_nav_history_buttons": false
    },
    "scrollbar": {
        "show": "auto"
    },
    "minimap": {
        "show": "never"
    },
    "indent_guides": {
        "enabled": true,
        "coloring": "indent_aware"
    },

    // =========================================================================
    // FILE HANDLING
    // =========================================================================
    "file_scan_exclusions": [
        "**/.git",
        "**/.DS_Store",
        "**/node_modules",
        "**/target",
        "**/build",
        "**/dist",
        "**/.venv",
        "**/__pycache__",
        "**/*.pyc",
        "**/bower_components"
    ],
    "autosave": {
        "after_delay": {
            "milliseconds": 1000
        }
    },
    "remove_trailing_whitespace_on_save": true,

    // =========================================================================
    // GIT
    // =========================================================================
    "git": {
        "inline_blame": {
            "enabled": true,
            "delay_ms": 300
        },
        "git_gutter": "tracked_files"
    },

    // =========================================================================
    // DIAGNOSTICS
    // =========================================================================
    "diagnostics": {
        "include_warnings": true
    },

    // =========================================================================
    // TELEMETRY
    // =========================================================================
    "telemetry": {
        "metrics": false,
        "diagnostics": false
    },

    // =========================================================================
    // LANGUAGE-SPECIFIC SETTINGS
    // =========================================================================
    "languages": {
        "Python": {
            "tab_size": 4,
            "format_on_save": "on",
            "rulers": [79, 120]
        },
        "JavaScript": {
            "tab_size": 2,
            "format_on_save": "on",
            "formatter": "prettier"
        },
        "TypeScript": {
            "tab_size": 2,
            "format_on_save": "on",
            "formatter": "prettier"
        },
        "TSX": {
            "tab_size": 2,
            "format_on_save": "on",
            "formatter": "prettier"
        },
        "JSX": {
            "tab_size": 2,
            "format_on_save": "on",
            "formatter": "prettier"
        },
        "C": {
            "tab_size": 4
        },
        "C++": {
            "tab_size": 4
        },
        "Ruby": {
            "tab_size": 2,
            "format_on_save": "on"
        },
        "Lua": {
            "tab_size": 4
        },
        "JSON": {
            "tab_size": 2
        },
        "JSONC": {
            "tab_size": 2
        },
        "YAML": {
            "tab_size": 2
        },
        "TOML": {
            "tab_size": 2
        },
        "CSS": {
            "tab_size": 2,
            "format_on_save": "on",
            "formatter": "prettier"
        },
        "HTML": {
            "tab_size": 2,
            "format_on_save": "on",
            "formatter": "prettier"
        },
        "Markdown": {
            "word_wrap": "bounded",
            "preferred_line_length": 80,
            "line_numbers": "off",
            "show_completions_on_input": false,
            "minimap": {
                "show": "never"
            },
            "gutter": {
                "line_numbers": false,
                "code_actions": false,
                "folds": true
            }
        },
        "Plain Text": {
            "word_wrap": "bounded",
            "preferred_line_length": 80,
            "line_numbers": "off",
            "show_completions_on_input": false
        }
    }
}
